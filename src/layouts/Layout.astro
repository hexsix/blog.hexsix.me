---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import SearchModal from "@/components/SearchModal.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /** JSON-LD 用的纯标题（不含 " | 站点名" 后缀），缺省时回退到 title */
  headline?: string;
  /** 分页页的上一页 / 下一页链接，用于 <link rel="prev|next"> */
  prev?: string;
  next?: string;
  /** 覆盖默认的 JSON-LD（例如画廊页传 ImageGallery） */
  structuredData?: Record<string, unknown> | null;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL: canonicalURLProp,
  headline,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  prev,
  next,
  structuredData: structuredDataProp,
} = Astro.props;

// canonical 始终基于 SITE.website 生成（dev 下也不会写出 localhost），
// 并统一补上尾斜杠，与 @astrojs/sitemap 的输出保持一致。
const toSiteURL = (path: string) => {
  const trimmed = path.replace(/\/$/, "");
  return new URL(trimmed === "" ? "/" : `${trimmed}/`, SITE.website);
};

const rawPath = Astro.url.pathname.replace(/\/$/, "");
const canonicalURL = canonicalURLProp ?? toSiteURL(rawPath);

// 分页链接同样归一化为绝对 URL + 尾斜杠，与 canonical 一致
const prevURL = prev ? toSiteURL(prev) : undefined;
const nextURL = next ? toSiteURL(next) : undefined;

const socialImageURL = new URL(ogImage, Astro.url);

// 只有带发布时间的页面才是文章。其余页面（首页 / 列表页 / 归档 / 搜索）
// 不能输出 BlogPosting，否则 datePublished 会变成 "undefined"。
const isArticle = Boolean(pubDatetime);

const person = {
  "@type": "Person",
  name: author,
  ...(profile && { url: profile }),
};

const defaultStructuredData = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
      headline: headline ?? title,
      description,
      image: socialImageURL.toString(),
      url: canonicalURL.toString(),
      datePublished: pubDatetime!.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [person],
      publisher: person,
    }
  : rawPath === ""
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.title,
        url: SITE.website,
        description: SITE.desc,
        inLanguage: SITE.lang || "en",
        potentialAction: {
          "@type": "SearchAction",
          target: `${SITE.website}search/?q={search_term_string}`,
          "query-input": "required name=search_term_string",
        },
      }
    : rawPath === "/about"
      ? {
          "@context": "https://schema.org",
          "@type": "ProfilePage",
          url: canonicalURL.toString(),
          mainEntity: { ...person, description },
        }
      : null;

const structuredData =
  structuredDataProp !== undefined ? structuredDataProp : defaultStructuredData;
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={`${SITE.lang ?? "en"}`}
  class={`${scrollSmooth ? "scroll-smooth" : ""}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- 分页序列关系 -->
    {prevURL && <link rel="prev" href={prevURL} />}
    {nextURL && <link rel="next" href={nextURL} />}

    <!-- Load Font -->
    {/* 本地字体无 subset 元信息，按 subset 过滤会命中不到任何变体。
        正文字体直接 preload，其余（引用体/等宽）按需加载，避免抢占带宽 */}
    <Font cssVariable="--font-wotfard" preload />
    <Font cssVariable="--font-sriracha" />
    <Font cssVariable="--font-firacode" />
    <Font cssVariable="--font-cascadia-code" />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:locale" content={SITE.lang === "zh" ? "zh_CN" : SITE.lang} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <!-- Global decorative backdrop (grid, glow, cursor glow, noise) -->
    <div class="site-backdrop pointer-events-none" aria-hidden="true">
      <div class="site-grid"></div>
      <div class="site-glow"></div>
      <div class="site-cursor-glow"></div>
      <div class="site-grain"></div>
    </div>

    <slot />

    <SearchModal />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>
  </body>
</html>

<style>
  .site-backdrop {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    z-index: 0;
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 40%,
      rgba(0, 0, 0, 0.3) 70%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 40%,
      rgba(0, 0, 0, 0.3) 70%,
      transparent 100%
    );
  }

  .site-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--accent) 1px, transparent 1px),
      linear-gradient(90deg, var(--accent) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.035;
    mask-image: radial-gradient(
      ellipse 100% 60% at 50% 0%,
      black 15%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 100% 60% at 50% 0%,
      black 15%,
      transparent 100%
    );
  }

  .site-glow {
    position: absolute;
    top: -15%;
    left: 50%;
    transform: translateX(-50%) translateZ(0);
    width: 800px;
    height: 550px;
    background: radial-gradient(
      ellipse at center,
      color-mix(in oklab, var(--accent) 100%, transparent) 0%,
      color-mix(in oklab, var(--accent) 80%, transparent) 10%,
      color-mix(in oklab, var(--accent) 60%, transparent) 20%,
      color-mix(in oklab, var(--accent) 45%, transparent) 30%,
      color-mix(in oklab, var(--accent) 30%, transparent) 40%,
      color-mix(in oklab, var(--accent) 18%, transparent) 50%,
      color-mix(in oklab, var(--accent) 10%, transparent) 60%,
      color-mix(in oklab, var(--accent) 4%, transparent) 70%,
      transparent 85%
    );
    opacity: 0.06;
    filter: blur(80px);
  }

  .site-cursor-glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 1100px;
    height: 1100px;
    margin-left: -550px;
    margin-top: -550px;
    transform: translate(var(--site-cx, 50vw), var(--site-cy, 50vh)) translateZ(0);
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--accent) calc(6% * var(--cursor-glow-strength)), transparent) 0%,
      color-mix(in oklab, var(--accent) calc(4% * var(--cursor-glow-strength)), transparent) 15%,
      color-mix(in oklab, var(--accent) calc(2.5% * var(--cursor-glow-strength)), transparent) 25%,
      color-mix(in oklab, var(--accent) calc(1.5% * var(--cursor-glow-strength)), transparent) 38%,
      color-mix(in oklab, var(--accent) calc(0.8% * var(--cursor-glow-strength)), transparent) 50%,
      color-mix(in oklab, var(--accent) calc(0.2% * var(--cursor-glow-strength)), transparent) 62%,
      transparent 75%
    );
    filter: blur(40px);
    opacity: 0;
    transition: opacity 0.5s ease;
    will-change: transform;
    pointer-events: none;
  }

  .site-cursor-glow.active {
    opacity: 1;
  }

  .site-grain {
    position: absolute;
    inset: 0;
    background-image: url("/noise.png");
    background-repeat: repeat;
    background-size: 64px 64px;
    opacity: 0.55;
    mix-blend-mode: overlay;
    pointer-events: none;
  }
</style>

<script>
  let cursorCleanup: AbortController | null = null;

  document.addEventListener("astro:page-load", () => {
    // Cleanup previous listeners
    if (cursorCleanup) cursorCleanup.abort();
    cursorCleanup = new AbortController();
    const { signal } = cursorCleanup;

    const cursorGlow = document.querySelector<HTMLElement>(".site-cursor-glow");
    let ticking = false;

    if (cursorGlow) {
      document.addEventListener(
        "mousemove",
        (e: MouseEvent) => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              cursorGlow.style.setProperty("--site-cx", `${e.clientX}px`);
              cursorGlow.style.setProperty("--site-cy", `${e.clientY}px`);
              if (!cursorGlow.classList.contains("active")) {
                cursorGlow.classList.add("active");
              }
              ticking = false;
            });
            ticking = true;
          }
        },
        { signal }
      );

      document.addEventListener(
        "mouseleave",
        () => {
          cursorGlow.classList.remove("active");
        },
        { signal }
      );
    }
  });
</script>
