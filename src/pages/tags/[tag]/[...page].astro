---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;

// 每一页给出独立的 title / description，避免分页页之间元信息重复
const metaTitle =
  page.currentPage > 1
    ? `标签：${tagName}（第 ${page.currentPage} 页） | ${SITE.title}`
    : `标签：${tagName} | ${SITE.title}`;
const metaDesc =
  page.currentPage > 1
    ? `标签「${tagName}」下的全部文章，共 ${page.total} 篇，第 ${page.currentPage} / ${page.lastPage} 页。`
    : `标签「${tagName}」下的全部文章，共 ${page.total} 篇。`;
---

<Layout
  title={metaTitle}
  description={metaDesc}
  prev={page.url.prev}
  next={page.url.next}
>
  <Header />
  <Main
    pageTitle={[`标签：`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`标签「${tagName}」下的全部文章。`}
  >
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
